<view class="page-shell">
  <navigation-bar
    title="{{title}}"
    back="{{back}}"
    catch-back="{{catchBack}}"
    bind:back="onNavBack"
    color="#3A2F26"
    background="#F7F0E6"
  >
    <view slot="right">
      <slot name="right"></slot>
    </view>
  </navigation-bar>
  <view class="page-shell__body">
    <slot></slot>
  </view>
</view>
