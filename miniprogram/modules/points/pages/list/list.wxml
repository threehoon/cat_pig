<page-shell title="积分明细" back="{{true}}">
  <scroll-view class="page-scroll" type="list" scroll-y>
    <view class="page-pad">
      <view class="stat-bar">
        <view class="stat-bar__item">
          <view class="stat-bar__num">{{earned}}</view>
          <view class="stat-bar__label">累计获取</view>
        </view>
        <view class="stat-bar__item">
          <view class="stat-bar__num">{{spent}}</view>
          <view class="stat-bar__label">累计消耗</view>
        </view>
        <view class="stat-bar__item">
          <view class="stat-bar__num">{{balance}}</view>
          <view class="stat-bar__label">当前积分</view>
        </view>
      </view>

      <view class="card rules">
        <text class="rules__title">怎么获得 / 消耗</text>
        <text class="rules__line">注册 +100（一次）</text>
        <text class="rules__line">每日签到 +10</text>
        <text class="rules__line">连续第 3 天额外 +20，送 1 张补签卡</text>
        <text class="rules__line">连续第 7 天额外 +50，送 1 张补签卡</text>
        <text class="rules__line">发帖成功 +20（每天前 3 条）</text>
        <text class="rules__line">评论 +5（每天 1 条）</text>
        <text class="rules__line">点赞 +2（每天 3 条）</text>
        <text class="rules__line">补签 +10（花 1 张补签卡）</text>
        <text class="rules__line">图生视频 −50</text>
      </view>

      <view class="chip-row chip-row--ledger">
        <view
          wx:for="{{filters}}"
          wx:key="id"
          class="chip {{filter === item.id ? 'chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFilter"
        >{{item.label}}</view>
      </view>
      <view wx:for="{{rows}}" wx:key="id" class="row-link">
        <view class="ledger-left">
          <image class="ledger-gift" src="{{gift}}" mode="aspectFit" />
          <view>
            <text>{{item.title}}</text>
            <text class="ledger-time">{{item.time}}</text>
          </view>
        </view>
        <text class="{{item.earn ? 'ledger-plus' : 'ledger-minus'}}">{{item.delta}}</text>
      </view>
    </view>
  </scroll-view>
</page-shell>
