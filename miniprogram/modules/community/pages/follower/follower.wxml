<page-shell title="粉丝" back="{{true}}">
  <scroll-view class="page-scroll" type="list" scroll-y>
    <view class="page-pad" wx:if="{{people.length === 0}}">
      <empty-state image="{{emptyPlaza}}" title="还没有粉丝" />
    </view>
    <view wx:else class="page-pad">
      <view class="card">
        <view class="person" wx:for="{{people}}" wx:key="id">
          <view class="avatar avatar--md">
            <image class="avatar__img" src="{{item.avatar}}" mode="aspectFill" />
          </view>
          <text class="person__name">{{item.nickname}}</text>
          <view
            class="person__btn {{item.following ? 'person__btn--ghost' : ''}}"
            data-id="{{item.id}}"
            data-action="{{item.following ? 'unfollow' : 'follow'}}"
            catchtap="onAction"
          >{{item.action}}</view>
        </view>
      </view>
    </view>
    <view class="list-end"></view>
  </scroll-view>
</page-shell>
