<page-shell title="广场">
  <scroll-view class="page-scroll" type="list" scroll-y>
    <view class="page-pad page-pad--head">
      <view class="search card">
        <input
          class="search__input"
          placeholder="搜索话题或养宠问题"
          value="{{q}}"
          confirm-type="search"
          bindinput="onQuery"
          bindconfirm="onSearch"
        />
        <text class="search__btn" bindtap="onSearch">搜索</text>
      </view>

      <view class="feed-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="id"
          class="feed-tab {{tab === item.id ? 'feed-tab--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTab"
        >{{item.label}}</view>
      </view>

      <block wx:if="{{watching.length}}">
        <view class="watch-head">
          <text class="section-title">大家都在看</text>
        </view>
        <scroll-view class="watch-scroll" type="list" scroll-x enable-flex show-scrollbar="{{false}}">
          <view
            wx:for="{{watching}}"
            wx:key="id"
            class="watch-card"
            data-id="{{item.id}}"
            bindtap="onWatch"
          >
            <image class="watch-card__img" src="{{item.cover}}" mode="aspectFill" />
            <text class="watch-card__cap" max-lines="1">{{item.body}}</text>
          </view>
        </scroll-view>
      </block>

      <view class="card hot">
        <text class="hot__kicker">本周热聊</text>
        <text class="hot__title">夏天怎么给毛孩子降温</text>
      </view>

      <empty-state
        wx:if="{{posts.length === 0}}"
        image="{{emptyPlaza}}"
        title="{{emptyTitle}}"
        hint="{{emptyHint}}"
        action="{{emptyAction}}"
        bind:action="onCompose"
      />
    </view>
    <post-card
      wx:for="{{posts}}"
      wx:key="id"
      post-id="{{item.id}}"
      author="{{item.author}}"
      avatar="{{item.avatar}}"
      time="{{item.time}}"
      board="{{item.board}}"
      body="{{item.body}}"
      covers="{{item.covers}}"
      show-media="{{item.showMedia}}"
      like-count="{{item.like_count}}"
      comment-count="{{item.comment_count}}"
      favorite-count="{{item.favorite_count}}"
      liked="{{item.liked}}"
      favorited="{{item.favorited}}"
      bind:opentap="onPost"
      bind:like="onLike"
      bind:favorite="onFavorite"
      bind:reply="onReply"
    />
    <view class="list-end list-end--fab"></view>
  </scroll-view>
  <view class="fab" bindtap="onCompose">发动态</view>
</page-shell>
