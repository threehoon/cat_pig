<page-shell title="我的">
  <scroll-view class="page-scroll" type="list" scroll-y>
    <view class="page-pad">
      <view class="card me-head">
        <view class="me-head__profile" bindtap="onProfile">
          <view class="avatar avatar--lg">
            <image class="avatar__img" src="{{avatar}}" mode="aspectFill" />
          </view>
          <view class="me-meta">
            <text class="me-name">{{nickname}}</text>
            <text class="me-points">积分 {{points_balance}}</text>
            <text class="me-edit-hint">点击编辑</text>
          </view>
        </view>
        <view class="stat-bar me-stats">
          <view class="stat-bar__item" data-kind="posts" catchtap="onStat">
            <view class="stat-bar__num">{{post_count}}</view>
            <view class="stat-bar__label">动态</view>
          </view>
          <view class="stat-bar__item" data-kind="likes" catchtap="onStat">
            <view class="stat-bar__num">{{like_received_count}}</view>
            <view class="stat-bar__label">获赞</view>
          </view>
          <view class="stat-bar__item" data-kind="following" catchtap="onStat">
            <view class="stat-bar__num">{{following_count}}</view>
            <view class="stat-bar__label">关注</view>
          </view>
          <view class="stat-bar__item" data-kind="followers" catchtap="onStat">
            <view class="stat-bar__num">{{follower_count}}</view>
            <view class="stat-bar__label">粉丝</view>
          </view>
        </view>
      </view>

      <view class="card menu">
        <view class="menu-row" bindtap="onMine">
          <text>我的发布</text>
          <text class="row-link__arrow">›</text>
        </view>
        <view class="menu-row" bindtap="onFavorites">
          <text>我的收藏</text>
          <text class="row-link__arrow">›</text>
        </view>
        <view class="menu-row" bindtap="onAlbum">
          <text>我的相册</text>
          <text class="row-link__arrow">›</text>
        </view>
        <view class="menu-row menu-row--last" bindtap="onRecords">
          <text>生成记录</text>
          <text class="row-link__arrow">›</text>
        </view>
      </view>

      <view class="card menu">
        <view class="menu-row" bindtap="onFollow">
          <text>我的关注</text>
          <text class="row-link__arrow">›</text>
        </view>
        <view class="menu-row menu-row--last" bindtap="onFollowers">
          <text>粉丝</text>
          <text class="row-link__arrow">›</text>
        </view>
      </view>

      <view class="card menu">
        <view class="menu-row" bindtap="onPoints">
          <text>积分明细</text>
          <text class="row-link__arrow">›</text>
        </view>
        <view class="menu-row menu-row--last" bindtap="onPointTasks">
          <text>积分任务</text>
          <text class="row-link__arrow">›</text>
        </view>
      </view>

      <view class="card menu">
        <view class="menu-row menu-row--last" bindtap="onSettings">
          <text>设置</text>
          <text class="row-link__arrow">›</text>
        </view>
      </view>
    </view>
  </scroll-view>
</page-shell>
