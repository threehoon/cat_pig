<page-shell title="上传到相册" back="{{true}}">
  <scroll-view class="page-scroll" scroll-y>
    <view class="page-pad">
      <view class="media-row">
        <view
          wx:for="{{image_urls}}"
          wx:key="*this"
          class="media-thumb"
          data-index="{{index}}"
          bindtap="onRemoveImage"
        >
          <image class="media-thumb__img" src="{{item}}" mode="aspectFill" />
        </view>
        <view wx:if="{{image_urls.length < 9}}" class="media-add" bindtap="onAddImage">+</view>
      </view>

      <view class="field">
        <view class="field__label">照片标题</view>
        <input class="field__input" placeholder="给这组照片起个名字" value="{{title}}" bindinput="onTitle" />
      </view>
      <view class="field">
        <view class="field__label">记录一下</view>
        <textarea
          class="field__input prompt"
          placeholder="写下此刻的心情或趣事"
          maxlength="500"
          value="{{body}}"
          bindinput="onBody"
        />
      </view>

      <view class="section-head">
        <text class="section-title">添加标签</text>
      </view>
      <view class="chip-row">
        <view
          wx:for="{{tag_items}}"
          wx:key="name"
          class="chip {{item.on ? 'chip--on' : ''}}"
          data-name="{{item.name}}"
          bindtap="onTag"
        >{{item.name}}</view>
      </view>

      <view class="row-link">
        <view>
          <text>同步到论坛</text>
          <text class="sync-sub">分享到广场，让更多人看到</text>
        </view>
        <switch color="#F0783C" checked="{{sync_to_forum}}" bindchange="onSync" />
      </view>

      <view class="btn btn--primary upload-submit" bindtap="onSubmit">保存到相册</view>
      <view wx:if="{{id}}" class="btn btn--ghost upload-submit" bindtap="onDelete">删除相册</view>
    </view>
  </scroll-view>
</page-shell>
